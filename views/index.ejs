<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>My Book Notes</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>📚 My Book Notes</h1>
    <p>Books I've read: <%= bookCount %>
    </p>

    <div class="top-bar">
        <a href="/add">+ Add a New Book</a>
        <p>
            Sort by:
            <a href="/?sortBy=title">Title</a> |
            <a href="/?sortBy=rating">Rating</a> |
            <a href="/?sortBy=date_read">Recency</a>
        </p>
    </div>

    <% books.forEach(function(book) { %>
        <div class="book-card">
            <img src="/cover/<%= book.isbn %>" alt="<%= book.title %> cover">
            <div class="book-info">
                <h2>
                    <%= book.title %>
                </h2>
                <p>By <%= book.author %>
                </p>
                <span class="rating">⭐ <%= book.rating %> / 5</span>
                <p>Read on: <%= book.date_read.toLocaleDateString() %>
                </p>
                <p>
                    <%= book.notes %>
                </p>
                <div class="actions">
                    <a href="/edit/<%= book.id %>">Edit</a>
                    <form action="/delete/<%= book.id %>" method="POST" style="display:inline;">
                        <button type="submit">Delete</button>
                    </form>
                </div>
            </div>
        </div>
        <% }); %>

</body>

</html>